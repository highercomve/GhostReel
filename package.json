{
  "name": "ghostreel",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "doctor": "cargo run -q -p ghostreel-cli -- doctor",
    "sidecars": "node scripts/fetch-sidecars.mjs && node scripts/stage-helpers.mjs",
    "bundle:linux": "npm run sidecars && NO_STRIP=true tauri build --config src-tauri/tauri.bundle.json --bundles appimage,deb && scripts/fix-appimage.sh",
    "bundle:windows": "npm run sidecars && tauri build --config src-tauri/tauri.bundle.json --bundles nsis",
    "bundle:cli": "scripts/package-cli.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-process": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
